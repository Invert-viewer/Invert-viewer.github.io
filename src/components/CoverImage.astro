---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  index: number;
  isListItem?: boolean;
}

const { src, alt, index, isListItem = false } = Astro.props as Props;

const isPrimaryCarouselImage = !isListItem || index === 0;

// Astro 的 <Image /> 需要 ImageMetadata；字符串（public 路径/远程 URL）用 <img> 兜底
const isStringSrc = typeof src === "string";
const imgSrc = isStringSrc ? (src as string) : undefined;
const assetSrc = !isStringSrc ? (src as ImageMetadata) : undefined;
---

{
  isListItem ? (
    <li class:list={["cover-item", { "is-current": isPrimaryCarouselImage }]}>
      {imgSrc ? (
        <img
          src={imgSrc}
          alt={alt}
          class="cover-image"
          loading={isPrimaryCarouselImage ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={isPrimaryCarouselImage ? "high" : "auto"}
        />
      ) : (
        <Image
          src={assetSrc!}
          alt={alt}
          layout="constrained"
          format="avif"
          priority={isPrimaryCarouselImage}
          quality={65}
          decoding={isPrimaryCarouselImage ? "sync" : "async"}
          class="cover-image"
        />
      )}
    </li>
  ) : imgSrc ? (
    <img
      src={imgSrc}
      alt={alt}
      class="single-image"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />
  ) : (
    <Image
      src={assetSrc!}
      alt={alt}
      layout="constrained"
      format="avif"
      class="single-image"
      priority={true}
      decoding="sync"
    />
  )
}

<style>
  .cover-item {
    position: absolute;
    inset: 0;
    background-color: var(--header-cover-bg);
    opacity: 0;
  }

  .cover-item.is-current {
    opacity: 1;
    z-index: 1;
  }

  .cover-item.is-incoming {
    z-index: 2;
  }

  .cover-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .single-image {
    height: 100%;
    width: 100%;
    left: 0;
    top: 0;
    position: absolute;
    object-fit: cover;
  }
</style>
